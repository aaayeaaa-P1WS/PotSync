/* ==========================================================================
   PotSync — Windows 11 风格样式模板
   --------------------------------------------------------------------------
   由 client/theme.py 在运行时做占位符替换后应用到 QApplication：
   深浅色、强调色都来自系统设置，切换主题会重新渲染本模板。
   变量清单见 theme.Palette.tokens()，改动时两边保持一致。
   ========================================================================== */

/* ---------- 基础 ---------- */

QWidget {
    background: transparent;
    color: $text;
    font-family: $font_family;
    font-size: 13px;
    selection-background-color: $accent;
    selection-color: $on_accent;
}

QMainWindow, QDialog, QMessageBox {
    background: $window_base;
    color: $text;
}

QWidget#root {
    background: qlineargradient(x1:0, y1:0, x2:0.35, y2:1,
                                stop:0 $bg_a, stop:1 $bg_end_a);
}

QWidget:disabled {
    color: $text_muted;
}

/* ---------- 卡片 ---------- */

QFrame#card {
    background: $surface_a;
    border: 1px solid $border;
    border-radius: 10px;
}

QFrame#cardFlat {
    background: $surface_alt_a;
    border: none;
    border-radius: 10px;
}

QFrame#divider {
    background: $border_a;
    max-height: 1px;
    border: none;
}

/* ---------- 文字 ---------- */

QLabel#title {
    font-family: "Segoe UI Variable Display", "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 26px;
    font-weight: 600;
    color: $text;
}

QLabel#subtitle {
    font-size: 13px;
    color: $text_dim;
}

QLabel#sectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: $text;
}

QLabel#cardTitle {
    font-size: 13px;
    font-weight: 600;
    color: $text;
}

QLabel#fieldLabel {
    color: $text_dim;
    font-size: 12.5px;
}

QLabel#tip {
    color: $text_muted;
    font-size: 12px;
}

QLabel#roomCode {
    font-family: "Segoe UI Variable Display", "Segoe UI", "Cascadia Mono", monospace;
    font-size: 30px;
    font-weight: 600;
    color: $accent_text;
}

QLabel#mediaName {
    font-size: 16px;
    font-weight: 600;
    color: $text;
}

QLabel#statusLine {
    color: $text_dim;
}

QLabel#syncLabel {
    color: $success;
    font-weight: 600;
}
QLabel#syncLabel[state="wait"] {
    color: $text_muted;
    font-weight: 400;
}
QLabel#syncLabel[state="warn"] {
    color: $warn;
    font-weight: 400;
}
QLabel#syncLabel[state="ok"] {
    color: $success;
}

QLabel#brandName {
    font-family: "Segoe UI Variable Display", "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: $text;
}

QLabel#versionLabel {
    color: $text_muted;
    font-size: 11.5px;
}

QLabel#connLabel {
    font-size: 12px;
    color: $text_muted;
}
QLabel#connLabel[state="idle"] { color: $text_muted; }
QLabel#connLabel[state="ok"] { color: $success; }
QLabel#connLabel[state="warn"] { color: $warn; }
QLabel#connLabel[state="bad"] { color: $danger; }

QLabel#badge {
    background: $accent_soft;
    color: $accent_text;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11.5px;
    font-weight: 600;
}

/* ---------- 输入 ---------- */

QLineEdit {
    background: $field_a;
    border: 1px solid $border;
    border-radius: $radius_small;
    padding: 7px 10px;
    color: $text;
    selection-background-color: $accent;
    selection-color: $on_accent;
}

QLineEdit:hover {
    border-color: $border_strong;
}

QLineEdit:focus {
    border: 1px solid $accent;
    background: $field_a;
}

QLineEdit[readOnly="true"] {
    background: $surface_alt_a;
    color: $text_dim;
}

/* ---------- 按钮 ---------- */

QPushButton {
    background: $surface_alt_a;
    border: 1px solid $border;
    border-radius: $radius_small;
    padding: 7px 16px;
    color: $text;
    min-height: 18px;
}

QPushButton:hover {
    background: $surface_hover_a;
    border-color: $border_strong;
}

QPushButton:pressed {
    background: $selected_a;
}

QPushButton:focus {
    border-color: $accent;
}

QPushButton:disabled {
    background: $surface_alt_a;
    color: $text_muted;
    border-color: $border;
}

QPushButton#primaryBtn {
    background: $accent;
    color: $on_accent;
    border: 1px solid $accent;
    font-weight: 600;
    padding: 8px 18px;
}

QPushButton#primaryBtn:hover { border-color: $accent_soft_strong; }
QPushButton#primaryBtn:pressed { border-color: $accent; }
QPushButton#primaryBtn:disabled { background: $accent_soft; color: $text_muted; border-color: transparent; }

QPushButton#dangerBtn {
    background: transparent;
    color: $danger;
    border: 1px solid $border;
}

QPushButton#dangerBtn:hover {
    background: $danger_soft;
    border-color: $danger;
}

QPushButton#ghostBtn, QPushButton#smallBtn {
    background: transparent;
    border: 1px solid transparent;
    color: $text_dim;
    padding: 5px 10px;
}

QPushButton#ghostBtn:hover, QPushButton#smallBtn:hover {
    background: $surface_hover_a;
    color: $text;
    border-color: transparent;
}

QPushButton#smallBtn {
    font-size: 12.5px;
}

QPushButton#infoBtn {
    background: transparent;
    border: 1px solid $border;
    border-radius: 9px;
    color: $text_dim;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 11px;
    font-weight: 600;
    padding: 0;
}

QPushButton#infoBtn:hover {
    background: $surface_hover;
    border-color: $border_strong;
    color: $text;
}

QPushButton#outlineBtn {
    background: transparent;
    border: 1px solid $border;
    color: $text;
    padding: 6px 14px;
}

QPushButton#outlineBtn:hover {
    background: $surface_hover;
    border-color: $border_strong;
}

QPushButton#outlineBtn:pressed {
    background: $selected;
}

QPushButton#navBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 9px 10px 9px 15px;
    text-align: left;
    color: $text_dim;
    font-size: 13.5px;
}

QPushButton#navBtn:hover {
    background: $surface_hover;
    color: $text;
}

QPushButton#navBtn:checked {
    background: $selected;
    color: $text;
    font-weight: 600;
}

QPushButton#navBtn:disabled {
    color: $text_muted;
    background: transparent;
}

QFrame#navIndicator {
    background: $accent;
    border: none;
    border-radius: 2px;
}

/* ---------- 勾选框 ---------- */

QCheckBox {
    color: $text;
    spacing: 9px;
    font-size: 13px;
}

QCheckBox:disabled {
    color: $text_muted;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid $border_strong;
    background: $surface;
}

QCheckBox::indicator:hover {
    border-color: $accent;
}

QCheckBox::indicator:checked {
    background: $accent;
    border: 1px solid $accent;
    image: url($check_on);
}

QCheckBox::indicator:disabled {
    border-color: $border;
    background: $surface_alt;
}

/* ---------- 滑块 ---------- */

QSlider::groove:horizontal {
    height: 4px;
    background: $border;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: $accent;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: transparent;
    border: none;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    image: url($slider_handle);
}


/* ---------- 列表 ---------- */

QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget#memberList::item {
    padding: 7px 8px;
    border-radius: $radius_small;
    color: $text;
}

QListWidget#memberList::item:hover {
    background: $surface_hover;
}

QListWidget#memberList::item:selected {
    background: $accent_soft;
    color: $text;
}

/* ---------- 日志 ---------- */

QPlainTextEdit#logView {
    background: $log_bg_a;
    border: 1px solid $border;
    border-radius: $radius;
    padding: 8px 10px;
    color: $text_dim;
    font-family: $mono_family;
    font-size: 12px;
}

/* ---------- 状态栏 ---------- */

QStatusBar {
    background: $status_a;
    border-top: 1px solid $border_a;
    color: $text_muted;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: $text_muted;
    font-size: 12px;
    padding: 0 6px;
}

/* ---------- 侧边栏 ---------- */

QFrame#sidebar {
    background: $sidebar_a;
    border: none;
    border-right: 1px solid $border;
}

QFrame#sidebarFooter {
    background: transparent;
    border: none;
    border-top: 1px solid $border;
}

/* ---------- 滚动条 ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: $scroll;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: $scroll_hover;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: $scroll;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: $scroll_hover;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
}

/* ---------- 提示 / 弹窗 ---------- */

QToolTip {
    background: $surface;
    color: $text;
    border: 1px solid $border;
    border-radius: $radius_small;
    padding: 6px 8px;
}

QMessageBox {
    background: $surface;
}

QMessageBox QLabel {
    color: $text;
}

/* ---------- 更新内容 / 说明浮层 ---------- */

QLabel#notesTitle {
    color: $text;
    font-size: 20px;
    font-weight: 600;
}

QLabel#notesSub {
    color: $text_dim;
    font-size: 13px;
}

QTextBrowser#notesView {
    background: transparent;
    border: none;
    padding: 2px 4px 0 0;
}

QFrame#hintCard {
    background: $surface;
    border: 1px solid $border_strong;
    border-radius: 8px;
}

QLabel#hintText {
    color: $text;
    background: transparent;
    border: none;
}
